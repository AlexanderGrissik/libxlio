digraph "XLIO Ultra API"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir=LR;
  Node7 [id="Node000007",label="Event Callbacks",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__xlio__callbacks.html",tooltip="Callback functions for handling socket events."];
  Node2 [id="Node000002",label="Initialization and\l Cleanup",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__xlio__init.html",tooltip="Functions for initializing and cleaning up the XLIO Ultra API."];
  Node3 [id="Node000003",label="Polling Groups",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__xlio__poll__group.html",tooltip="Functions for managing polling groups and event handling."];
  Node6 [id="Node000006",label="Receive Operations",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__xlio__rx.html",tooltip="Zero-copy receive buffer management."];
  Node4 [id="Node000004",label="Socket Management",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__xlio__socket.html",tooltip="Functions for creating and managing XLIO sockets."];
  Node5 [id="Node000005",label="Transmit Operations",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__xlio__tx.html",tooltip="High-performance data transmission functions."];
  Node1 [id="Node000001",label="XLIO Ultra API",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="High-performance zero-copy networking interface."];
  Node1->Node2 [shape=plaintext, dir="back", style="solid"];
  Node1->Node3 [shape=plaintext, dir="back", style="solid"];
  Node1->Node4 [shape=plaintext, dir="back", style="solid"];
  Node1->Node5 [shape=plaintext, dir="back", style="solid"];
  Node1->Node6 [shape=plaintext, dir="back", style="solid"];
  Node1->Node7 [shape=plaintext, dir="back", style="solid"];

\Hypertarget{group__xlio__callbacks_ga3ca90ca4067870b6b8d2dcd25a93a4e5}\label{group__xlio__callbacks_ga3ca90ca4067870b6b8d2dcd25a93a4e5} 
\index{Event Callbacks@{Event Callbacks}!xlio\_socket\_event\_cb\_t@{xlio\_socket\_event\_cb\_t}}
\index{xlio\_socket\_event\_cb\_t@{xlio\_socket\_event\_cb\_t}!Event Callbacks@{Event Callbacks}}
\doxysubsubsubsection{\texorpdfstring{xlio\_socket\_event\_cb\_t}{xlio\_socket\_event\_cb\_t}}
{\footnotesize\ttfamily typedef void(\texorpdfstring{$\ast$}{*} xlio\+\_\+socket\+\_\+event\+\_\+cb\+\_\+t) (\mbox{\hyperlink{group__xlio__socket_ga38bd8a56da936ea6bbced26cd3009588}{xlio\+\_\+socket\+\_\+t}} sock, uintptr\+\_\+t userdata\+\_\+sq, int event, int value)}



Socket event callback function. 

This callback is invoked when socket state changes occur, such as connection establishment, errors, or termination.


\begin{DoxyParams}{Parameters}
{\em sock} & The socket generating the event \\
\hline
{\em userdata\+\_\+sq} & User data associated with the socket \\
\hline
{\em event} & The event type (XLIO\+\_\+\+SOCKET\+\_\+\+EVENT\+\_\+\texorpdfstring{$\ast$}{*}) \\
\hline
{\em value} & Event-\/specific value (error code for ERROR events, 0 otherwise)\\
\hline
\end{DoxyParams}
\begin{DoxyParagraph}{Event Types\+:}

\begin{DoxyItemize}
\item XLIO\+\_\+\+SOCKET\+\_\+\+EVENT\+\_\+\+ESTABLISHED\+: TCP connection established
\item XLIO\+\_\+\+SOCKET\+\_\+\+EVENT\+\_\+\+TERMINATED\+: Socket terminated, no further events
\item XLIO\+\_\+\+SOCKET\+\_\+\+EVENT\+\_\+\+CLOSED\+: Passive close by remote peer
\item XLIO\+\_\+\+SOCKET\+\_\+\+EVENT\+\_\+\+ERROR\+: Error occurred, see value for error code
\end{DoxyItemize}
\end{DoxyParagraph}
\begin{DoxyParagraph}{Error Codes (for ERROR events)\+:}

\begin{DoxyItemize}
\item ECONNABORTED\+: Connection aborted by local side
\item ECONNRESET\+: Connection reset by remote side
\item ECONNREFUSED\+: Connection refused during handshake
\item ETIMEDOUT\+: Connection timed out
\end{DoxyItemize}
\end{DoxyParagraph}
\begin{DoxyNote}{Note}
Send operations are allowed only from the ESTABLISHED event context.
\end{DoxyNote}
\begin{DoxySeeAlso}{See also}
\doxylink{structxlio__poll__group__attr}{xlio\+\_\+poll\+\_\+group\+\_\+attr} 
\end{DoxySeeAlso}

\index{Event Callbacks@{Event Callbacks}!xlio\_socket\_rx\_cb\_t@{xlio\_socket\_rx\_cb\_t}}
\index{xlio\_socket\_rx\_cb\_t@{xlio\_socket\_rx\_cb\_t}!Event Callbacks@{Event Callbacks}}
\doxysubsubsubsection{\texorpdfstring{xlio\_socket\_rx\_cb\_t}{xlio\_socket\_rx\_cb\_t}}
{\footnotesize\ttfamily typedef void(\texorpdfstring{$\ast$}{*} xlio\+\_\+socket\+\_\+rx\+\_\+cb\+\_\+t) (\mbox{\hyperlink{group__xlio__socket_ga38bd8a56da936ea6bbced26cd3009588}{xlio\+\_\+socket\+\_\+t}} sock, uintptr\+\_\+t userdata\+\_\+sq, void \texorpdfstring{$\ast$}{*}data, size\+\_\+t len, struct \mbox{\hyperlink{structxlio__buf}{xlio\+\_\+buf}} \texorpdfstring{$\ast$}{*}buf)}



Receive data callback function. 

This callback is invoked when TCP payload arrives on a socket. Each call provides a single contiguous buffer containing received data.


\begin{DoxyParams}{Parameters}
{\em sock} & The socket that received the data \\
\hline
{\em userdata\+\_\+sq} & User data associated with the socket \\
\hline
{\em data} & Pointer to the received data \\
\hline
{\em len} & Length of the received data \\
\hline
{\em buf} & Buffer descriptor that must be returned via xlio\+\_\+\texorpdfstring{$\ast$}{*}\+\_\+buf\+\_\+free()\\
\hline
\end{DoxyParams}
\begin{DoxyNote}{Note}
The data pointer is valid only until the buffer is freed. The buffer\textquotesingle{}s userdata field can be used during user ownership.
\end{DoxyNote}
\begin{DoxySeeAlso}{See also}

\doxysubsubsubsection{\texorpdfstring{xlio\_memory\_cb\_t}{xlio\_memory\_cb\_t}}
{\footnotesize\ttfamily typedef void(\texorpdfstring{$\ast$}{*} xlio\+\_\+memory\+\_\+cb\+\_\+t) (void \texorpdfstring{$\ast$}{*}addr, size\+\_\+t len, size\+\_\+t hugepage\+\_\+size)}



Memory allocation callback function. 

This callback is invoked when XLIO allocates memory regions that can be used for RX buffers. Applications can use this information for memory management or preparation.


\begin{DoxyParams}{Parameters}
{\em addr} & Base address of the allocated memory \\
\hline
{\em len} & Size of the allocated memory \\
\hline
{\em hugepage\+\_\+size} & Page size if hugepages are used, 0 for regular pages\\
\hline
\end{DoxyParams}
\begin{DoxyNote}{Note}
If hugepage\+\_\+size is non-\/zero, both addr and len are aligned to the page size boundary. For external allocators, hugepage\+\_\+size is always reported as zero.
\end{DoxyNote}

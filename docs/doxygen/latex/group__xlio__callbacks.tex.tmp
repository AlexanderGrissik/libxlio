\doxysubsubsubsection{\texorpdfstring{xlio\_socket\_comp\_cb\_t}{xlio\_socket\_comp\_cb\_t}}
{\footnotesize\ttfamily typedef void(\texorpdfstring{$\ast$}{*} xlio\+\_\+socket\+\_\+comp\+\_\+cb\+\_\+t) (\mbox{\hyperlink{group__xlio__socket_ga38bd8a56da936ea6bbced26cd3009588}{xlio\+\_\+socket\+\_\+t}} sock, uintptr\+\_\+t userdata\+\_\+sq, uintptr\+\_\+t userdata\+\_\+op)}



Zero-\/copy completion callback function. 

This callback is invoked when a zero-\/copy send operation completes, allowing the application to reclaim or reuse the transmitted buffers.


\begin{DoxyParams}{Parameters}
{\em sock} & The socket that completed the operation \\
\hline
{\em userdata\+\_\+sq} & User data associated with the socket \\
\hline
{\em userdata\+\_\+op} & User data associated with the specific operation\\
\hline
\end{DoxyParams}
\begin{DoxyParagraph}{Calling Contexts\+:}

\begin{DoxyItemize}
\item \doxylink{group__xlio__poll__group_gafc07446ac8afb352c6b425b2e5cb4efc}{xlio\+\_\+poll\+\_\+group\+\_\+poll()} (most common)
\item \doxylink{group__xlio__tx_ga8a29d7bfbf64060ae099e4e0d0aa878f}{xlio\+\_\+socket\+\_\+send()} (if data is immediately flushed)
\item \doxylink{group__xlio__tx_gac300e5a65b6a40e915374a0260903a47}{xlio\+\_\+socket\+\_\+flush()} / \doxylink{group__xlio__tx_ga1f6be5297f39da8071071b7ac1e0a773}{xlio\+\_\+poll\+\_\+group\+\_\+flush()}
\end{DoxyItemize}
\end{DoxyParagraph}
\begin{DoxyNote}{Note}
Send operations are allowed in this callback unless the socket is being destroyed.
\end{DoxyNote}
